# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Portal
ECNH_BASE_URL=

# Credenciais legadas de teste (opcional)
# ECNH_CPF=
# ECNH_PASSWORD=

# Credenciais por profissional (preferencial)
# Use ECNH_LOGIN_USER_INDEX para escolher um usuário específico nos scripts de login.
# Para sincronização, use ENABLED=true com NAME, CPF e PASSWORD.
# Os índices ECNH_USER_<n>_ são descobertos dinamicamente a partir do .env (sem limite fixo).
# Sem ECNH_LOGIN_USER_INDEX, o primeiro usuário com ENABLED=true e senha preenchida é usado no login.
# ECNH_LOGIN_USER_INDEX=1

# Profissionais habilitados (ENABLED=true)
# PROFILE opcional: psicologo | medico (também aceita ROLE=Psicologo|Medico).
# Sem PROFILE, o client detecta o perfil pelo HTML pós-login.
# CLINIC obrigatório na sincronização: nome cadastrado no .env, traduzido para
# a coluna Unidade da planilha (LIMÃO, CAPÃO REDONDO, VILA CARRÃO).
# Exemplos: "Talento Limão/Zona Norte" | "Capão Redondo/Zona Sul" | "Clínica Carrão/Zona Leste"
# UNIDADE / UNID_TRANSITO (B011 / Fase 003D): obrigatórios somente se o portal
# exibir "Escolha de Perfil e/ou Visão". Precedência: UNID_TRANSITO (id) > UNIDADE (rótulo).
# ECNH_USER_<n>_UNIDADE=CIR-SAO PAULO
# ECNH_USER_<n>_UNID_TRANSITO=18
ECNH_USER_1_NAME=
ECNH_USER_1_CLINIC=Talento Limão/Zona Norte
ECNH_USER_1_PROFILE=psicologo
ECNH_USER_1_ENABLED=true
ECNH_USER_1_CPF=
ECNH_USER_1_PASSWORD=

ECNH_USER_2_NAME=Italo
ECNH_USER_2_CLINIC=
ECNH_USER_2_PROFILE=medico
ECNH_USER_2_ENABLED=true
ECNH_USER_2_CPF=
ECNH_USER_2_PASSWORD=

ECNH_USER_3_NAME=Caio
ECNH_USER_3_CLINIC=
ECNH_USER_3_PROFILE=medico
ECNH_USER_3_ENABLED=true
ECNH_USER_3_CPF=
ECNH_USER_3_PASSWORD=

# Profissionais desabilitados (ENABLED=false)
ECNH_USER_4_NAME=
ECNH_USER_4_CLINIC=
ECNH_USER_4_PROFILE=psicologo
ECNH_USER_4_ENABLED=false
ECNH_USER_4_CPF=
ECNH_USER_4_PASSWORD=

# Validação reproduzível (npm run validate:login)
# LOGIN_VALIDATION_ATTEMPTS=5
# LOGIN_VALIDATION_DELAY_MS=5000

# Google Sheets (Fase 005)
# Compartilhe a planilha com o e-mail da Service Account (permissão de Editor).
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_SHEET_NAME=Agenda
# Local: path para o JSON da Service Account
# GOOGLE_SHEETS_CREDENTIALS_PATH=./secrets/google-service-account.json
# Alternativa padrão do Google:
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Produção (Railway): JSON completo em variável secreta (preferencial no Cron efêmero)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Agendamento automático local (Fase 007) — npm run job:agenda
# Expressão cron obrigatória (5 ou 6 campos) — NÃO usar no serviço Cron do Railway.
# Padrão local recomendado: diário às 16:00 (fuso America/Sao_Paulo).
AGENDA_SYNC_CRON=0 16 * * *
# Fuso IANA (default: America/Sao_Paulo)
# AGENDA_SYNC_TZ=America/Sao_Paulo
# Arquivo de lock global compartilhado com sync:agenda (default: .data/agenda-sync.lock)
# AGENDA_SYNC_LOCK_PATH=.data/agenda-sync.lock

# Deploy Railway (Cron efêmero) — ver docs/DEPLOY_RAILWAY.md
# No painel: Cron Schedule = 0 19 * * * (UTC ≡ 16:00 America/Sao_Paulo)
# Start Command = npm start  (node dist/scripts/sync-agenda.js)
# Não defina AGENDA_SYNC_CRON no serviço Cron do Railway.
# Atualização inteligente de credenciais — npm run refresh:credenciais
# Auditoria (catálogo × todos os ECNH_USER, incl. ENABLED=false) — npm run audit:credenciais
# Catálogo local (gitignored). Exemplo: docs/exemplos/credenciais-candidatas.example.json
# ECNH_CREDENTIAL_CANDIDATES_PATH=./secrets/credenciais-candidatas.json
# Opcional: caminho do .env oficial a persistir (default: .env)
# ECNH_ENV_FILE_PATH=.env
