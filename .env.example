# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Portal
ECNH_BASE_URL=

# Credenciais legadas de teste (opcional)
# ECNH_CPF=
# ECNH_PASSWORD=

# Credenciais por profissional (preferencial)
# Use ECNH_LOGIN_USER_INDEX para escolher um usuário específico.
# Sem esse índice, o primeiro usuário com ENABLED=true e senha preenchida é usado.
# ECNH_LOGIN_USER_INDEX=1
ECNH_USER_1_NAME=
ECNH_USER_1_CLINIC=
ECNH_USER_1_ROLE=Psicologo
ECNH_USER_1_ENABLED=true
ECNH_USER_1_CPF=
ECNH_USER_1_PASSWORD=

# Validação reproduzível (npm run validate:login)
# LOGIN_VALIDATION_ATTEMPTS=5
# LOGIN_VALIDATION_DELAY_MS=5000

# Google Sheets (Fase 005)
# Compartilhe a planilha com o e-mail da Service Account (permissão de Editor).
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_SHEET_NAME=Agenda
# GOOGLE_SHEETS_CREDENTIALS_PATH=./secrets/google-service-account.json
# Alternativa padrão do Google:
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
