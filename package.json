{
  "name": "e-cnh",
  "version": "0.1.0",
  "private": true,
  "description": "Sincronizador de agendas futuras entre o portal e-CNH SP e Google Sheets.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/**/*.test.ts",
    "test:login": "tsx src/scripts/test-login.ts",
    "test:ecnh-connectivity": "tsx src/scripts/test-ecnh-connectivity.ts",
    "test:ecnh-connectivity:prod": "node dist/scripts/test-ecnh-connectivity.js",
    "test:agenda": "tsx src/scripts/test-agenda.ts",
    "test:agenda-parser": "tsx --test src/parsers/agenda-parser.test.ts",
    "test:agenda-sync": "tsx --test src/services/agenda-sync-service.test.ts",
    "test:sheets": "tsx --test src/repositories/agenda-sheet-mapper.test.ts src/repositories/google-sheets-agenda-repository.test.ts",
    "validate:login": "tsx src/scripts/validate-login.ts",
    "validate:agenda": "tsx src/scripts/validate-agenda.ts",
    "validate:agenda-parser": "tsx src/scripts/validate-agenda-parser.ts",
    "validate:sheets": "tsx src/scripts/validate-sheets.ts",
    "sync:agenda": "tsx src/scripts/sync-agenda.ts",
    "sync:agenda:prod": "node dist/index.js",
    "job:agenda": "tsx src/scripts/job-agenda.ts",
    "job:agenda:prod": "node dist/scripts/job-agenda.js",
    "refresh:credenciais": "tsx src/scripts/refresh-credentials.ts",
    "audit:credenciais": "tsx src/scripts/audit-credentials.ts",
    "validate:agenda-job": "tsx src/scripts/validate-agenda-job.ts",
    "test:agenda-job": "tsx --test src/jobs/*.test.ts src/config/agenda-sync-job-config.test.ts",
    "discover:logout": "tsx src/scripts/discover-logout.ts",
    "discover:agenda": "tsx src/scripts/discover-agenda-navigation.ts",
    "discover:agenda-html": "tsx src/scripts/discover-agenda-html.ts",
    "discover:sheets": "tsx src/scripts/discover-sheets.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "googleapis": "^144.0.0",
    "http-cookie-agent": "^8.0.0",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "proper-lockfile": "^4.1.2",
    "tough-cookie": "^6.0.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.15.2",
    "@types/node-cron": "^3.0.11",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
